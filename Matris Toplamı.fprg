<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Matris Toplam&#305;"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 05:21:15 AM"/>
        <attribute name="created" value="dXNlcjtXSU4tU0YyUVJON1BJR0w7MjAyNi0xMC0wMTswNToxNTozNiBBTTsyNzkw"/>
        <attribute name="edited" value="dXNlcjtXSU4tU0YyUVJON1BJR0w7MjAyNi0xMC0wMTswNToyMToxNSBBTTsxOzI4OTI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="k" type="Integer" array="False" size=""/>
            <declare name="A" type="Integer" array="True" size="9"/>
            <for variable="k" start="0" end="8" direction="inc" step="1">
                <input variable="A[k]"/>
            </for>
            <declare name="B" type="Integer" array="True" size="9"/>
            <for variable="k" start="0" end="8" direction="inc" step="1">
                <input variable="B[k]"/>
            </for>
            <declare name="S" type="Integer" array="True" size="9"/>
            <for variable="k" start="0" end="8" direction="inc" step="1">
                <assign variable="S[k]" expression="A[k] + B[k]"/>
            </for>
            <for variable="k" start="0" end="8" direction="inc" step="1">
                <output expression="S[k]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
